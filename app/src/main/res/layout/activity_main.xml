<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTO SUB"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa chọn video"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnChooseVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn video"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtSubtitle"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="top"
            android:hint="Nhập hoặc dán phụ đề tiếng Việt..."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xuất phụ đề SRT"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sẵn sàng"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>
